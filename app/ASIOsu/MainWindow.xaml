<Window x:Class="ASIOsu.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#FFF7F7F7">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="#18000000" BorderThickness="0,0,0,1">
      <Grid x:Name="TitleBar" Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Ellipse Width="20" Height="20" Stroke="#0F6CBD" StrokeThickness="2" /><TextBlock Text="ASIOsu" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
        <TextBlock x:Name="TitleStatus" Grid.Column="1" Text="준비 중" Foreground="#666666" VerticalAlignment="Center" />
        <Button Grid.Column="2" Width="38" Height="34" Padding="0" Click="RefreshButton_Click"><FontIcon Glyph="&#xE72C;" FontSize="15" /></Button>
      </Grid>
    </Border>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="244" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="OverviewItem" Content="현재 상태" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="RouteItem" Content="오디오 경로" Tag="route"><NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="12,8,12,16" Spacing="7"><TextBlock Text="게임 폴더" FontWeight="SemiBold" FontSize="12" /><TextBlock x:Name="SidebarPath" Text="—" FontSize="12" TextWrapping="Wrap" MaxLines="3" /><Button Content="폴더 변경" HorizontalAlignment="Stretch" Click="ChooseFolderButton_Click" /></StackPanel>
      </NavigationView.PaneFooter>
      <Grid Margin="34,24,34,30">
        <Grid x:Name="OverviewPage">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" MaxWidth="940">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3"><TextBlock Text="현재 상태" FontSize="32" FontWeight="Light" /><TextBlock x:Name="StatusSubtitle" Text="게임과 오디오 브리지를 확인합니다." Foreground="#666666" /></StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="16" Background="#FFE5F1FB" VerticalAlignment="Top"><TextBlock x:Name="StatusBadge" Text="확인 중" FontSize="12" FontWeight="SemiBold" /></Border>
              </Grid>
              <Border CornerRadius="8" BorderThickness="1" BorderBrush="#18000000" Background="White" Padding="22,18">
                <StackPanel Spacing="12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="출력 경로" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="게임 믹서부터 ASIO 드라이버까지 실제 선택된 경로" Foreground="#666666" /></StackPanel><TextBlock Grid.Column="1" Text="ASIO" Foreground="#0F6CBD" FontWeight="SemiBold" /></Grid>
                  <Grid Height="70" Margin="6,5,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /><ColumnDefinition /><ColumnDefinition Width="52" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><Ellipse Width="13" Height="13" Fill="#202020" HorizontalAlignment="Left" /><TextBlock Text="osu!lazer" Margin="0,7,0,0" FontWeight="SemiBold" /><TextBlock Text="원본 BASS" FontSize="12" Foreground="#666666" /></StackPanel>
                    <Rectangle Grid.Column="1" Height="2" Fill="#202020" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Ellipse Width="13" Height="13" Fill="#0F6CBD" /><TextBlock Text="BASSWASAPI 브리지" Margin="0,7,0,0" FontWeight="SemiBold" /><TextBlock Text="독립 구현" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" /></StackPanel>
                    <Rectangle Grid.Column="3" Height="2" Fill="#0F6CBD" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right"><Ellipse Width="13" Height="13" Fill="#0F6CBD" HorizontalAlignment="Right" /><TextBlock Text="ASIO 출력" Margin="0,7,0,0" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock x:Name="RouteSummary" Text="설정 필요" FontSize="12" Foreground="#666666" HorizontalAlignment="Right" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="설치 및 복구" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Border CornerRadius="8" BorderThickness="1" BorderBrush="#18000000" Background="White">
                <StackPanel>
                  <Grid Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="ASIO 브리지" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="BridgeState" Grid.Column="1" Text="확인 중" Foreground="#666666" VerticalAlignment="Center" TextWrapping="Wrap" /><Button x:Name="InstallButton" Grid.Column="2" Content="설치 또는 업데이트" Click="InstallButton_Click" VerticalAlignment="Center" /></Grid>
                  <Rectangle Height="1" Fill="#18000000" Margin="20,0" />
                  <Grid Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="원본 복구" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="RestoreState" Grid.Column="1" Text="—" Foreground="#666666" VerticalAlignment="Center" /><Button x:Name="RestoreButton" Grid.Column="2" Content="원본으로 복구" Click="RestoreButton_Click" VerticalAlignment="Center" /></Grid>
                  <Rectangle Height="1" Fill="#18000000" Margin="20,0" />
                  <Grid Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="파일 호환성" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="CompatibilityState" Grid.Column="1" Text="원본 파일과 payload를 검사합니다." Foreground="#666666" VerticalAlignment="Center" /><Button x:Name="CheckButton" Grid.Column="2" Content="검사" Click="CheckButton_Click" VerticalAlignment="Center" /></Grid>
                  <Rectangle Height="1" Fill="#18000000" Margin="20,0" />
                  <Grid Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="게임 폴더" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="GamePathText" Grid.Column="1" Text="—" Foreground="#666666" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="2" Content="변경" Click="ChooseFolderButton_Click" VerticalAlignment="Center" /></Grid>
                  <Rectangle Height="1" Fill="#18000000" Margin="20,0" />
                  <Grid Height="64" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="ASIOsu 업데이트" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="UpdateState" Grid.Column="1" Text="현재 버전 확인 중" Foreground="#666666" VerticalAlignment="Center" /><Button x:Name="UpdateButton" Grid.Column="2" Content="확인" Click="UpdateButton_Click" VerticalAlignment="Center" /></Grid>
                </StackPanel>
              </Border>
              <InfoBar x:Name="OverviewInfo" IsOpen="False" IsClosable="True" Margin="0,0,0,6" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="RoutePage" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="940">
              <StackPanel Spacing="3"><TextBlock Text="오디오 경로" FontSize="32" FontWeight="Light" /><TextBlock Text="ASIO 드라이버와 stereo 출력 쌍을 선택합니다." Foreground="#666666" /></StackPanel>
              <Border CornerRadius="8" BorderThickness="1" BorderBrush="#18000000" Background="White" Padding="22">
                <Grid ColumnSpacing="22" RowSpacing="18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Text="ASIO 드라이버" VerticalAlignment="Center" FontWeight="SemiBold" /><ComboBox x:Name="DriverCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="DriverCombo_SelectionChanged" />
                  <TextBlock Grid.Row="1" Text="출력 쌍" VerticalAlignment="Center" FontWeight="SemiBold" /><ComboBox x:Name="PairCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />
                  <TextBlock Grid.Row="2" Text="샘플레이트" VerticalAlignment="Center" FontWeight="SemiBold" /><ComboBox x:Name="RateCombo" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="44100" /><ComboBoxItem Content="48000" /><ComboBoxItem Content="88200" /><ComboBoxItem Content="96000" /></ComboBox>
                  <TextBlock Grid.Row="3" Text="버퍼 프레임" VerticalAlignment="Center" FontWeight="SemiBold" /><NumberBox x:Name="BufferBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="8192" SpinButtonPlacementMode="Compact" Value="32" />
                  <TextBlock Grid.Row="4" Text="드라이버 범위" VerticalAlignment="Top" FontWeight="SemiBold" /><TextBlock x:Name="DriverRangeText" Grid.Row="4" Grid.Column="1" Text="드라이버를 선택하면 표시됩니다." Foreground="#666666" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ReadDriverButton" Content="드라이버 채널 읽기" Click="ReadDriverButton_Click" /><Button x:Name="SaveRouteButton" Content="설정 저장" Click="SaveRouteButton_Click" Background="#0F6CBD" Foreground="White" /></StackPanel>
              <InfoBar x:Name="RouteInfo" IsOpen="False" IsClosable="True" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
