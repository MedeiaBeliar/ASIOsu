<Application
    x:Class="ASIOsu.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
      <SolidColorBrush x:Key="MutedBrush" Color="#666666" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="RuleBrush" Color="#16000000" />
      <SolidColorBrush x:Key="BadgeBrush" Color="#FFE5F1FB" />
      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="16,6" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>

