<UserControl x:Class="ASIOsu.StablePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MaxWidth="940" Padding="0,0,0,12">
      <StackPanel Spacing="4">
        <TextBlock Text="osu!stable" FontSize="32" FontWeight="Light" />
        <TextBlock Text="실행 중인 게임의 Windows 오디오를 ASIO로 보냅니다." TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="게임 설정" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <Button x:Name="FolderButton" Content="stable 폴더 변경" Click="PickFolder" />
          <ComboBox x:Name="DeviceCombo" Header="게임의 Windows 출력 장치" HorizontalAlignment="Stretch"
                    DisplayMemberPath="Label" />
          <TextBlock Text="원래 출력과 ASIO 소리가 겹치면 모니터링하지 않는 별도 장치를 선택하세요. 저장할 때는 게임을 종료해야 합니다."
                     TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Button x:Name="DeviceButton" Content="게임 출력 장치 저장" Click="SaveDevice" />
          <InfoBar x:Name="DeviceInfo" IsClosable="True" />
        </StackPanel>
      </Border>
      <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="ASIO 출력" FontSize="20" FontWeight="SemiBold" />
          <ComboBox x:Name="DriverCombo" Header="ASIO 드라이버" HorizontalAlignment="Stretch"
                    SelectionChanged="DriverChanged" />
          <ComboBox x:Name="PairCombo" Header="ASIO 출력 쌍" HorizontalAlignment="Stretch" />
          <ComboBox x:Name="RateCombo" Header="장치 샘플레이트 (Hz)" HorizontalAlignment="Stretch" />
          <NumberBox x:Name="BufferBox" Header="버퍼 프레임" Minimum="1" Maximum="8192" SpinButtonPlacementMode="Compact" />
          <TextBlock x:Name="StatusText" Text="대기 중" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ConnectButton" Content="ASIO 연결" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                    Click="ToggleCapture" />
            <Button x:Name="ReloadButton" Content="장치 새로 고침" Click="Reload" />
          </StackPanel>
          <InfoBar x:Name="CaptureInfo" IsClosable="True" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
